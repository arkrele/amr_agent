# Mesh Agent 环境配置
# 复制此文件为 .env 并填入你的真实信息
# cp .env.example .env

OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com

# API 超时 (秒), 默认 180
MESH_AGENT_API_TIMEOUT=180

# 可选: 指定模型 (默认 deepseek-chat)
# MESH_AGENT_STRONG_MODEL=deepseek-chat
# MESH_AGENT_LIGHT_MODEL=deepseek-chat
